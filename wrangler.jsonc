// Kotoba Party on Cloudflare: see docs/cloudflare.md and ADR 0003.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kotoba-party",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-09-01",
  // node:crypto, node:zlib and process.env for the shared server code (room tokens, the Ink Storm PNG, the Claude client).
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // Built by `npm run build`: dist/stage and dist/controller. The Worker maps paths onto them.
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomObject"] }],
  // Workers AI, for speech to text (STT_URL "workers-ai", docs/speech.md). `wrangler dev` calls it remotely and is billed.
  "ai": { "binding": "AI" },
  "observability": { "enabled": true },
  "vars": {
    // Optional; leave empty to use the request's own origin for the QR code.
    "PUBLIC_URL": "",
    // Optional; e.g. https://voicevox.example.com. Empty: subtitles only.
    "VOICEVOX_URL": "",
    // Optional; the reader service (npm run reader). Empty: kanji answers are compared as written.
    "READER_URL": "",
    // Speech to text: "workers-ai" runs Whisper on Cloudflare Workers AI through the AI binding above, or a
    // self-hosted Whisper server's endpoint, e.g. https://stt.example.com/inference.
    // Empty: no hold-to-talk, phones type or tap. Audio never goes to Google (docs/speech.md).
    "STT_URL": "workers-ai",
    // Optional; the Workers AI model (default @cf/openai/whisper-large-v3-turbo), or the `model` field for
    // self-hosted servers that host several (speaches). whisper.cpp ignores it.
    "STT_MODEL": ""
  }
}
