// Kotoba Party on Cloudflare: see docs/cloudflare.md and ADR 0003.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kotoba-party",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-09-01",
  // node:crypto, node:zlib and process.env for the shared server code (room tokens, the Ink Storm PNG, the Claude client).
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // Built by `npm run build`: dist/stage and dist/controller. The Worker maps paths onto them.
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomObject"] }],
  // Workers AI, for speech to text (STT_URL "workers-ai", docs/speech.md). `wrangler dev` calls it remotely and is billed.
  "ai": { "binding": "AI" },
  "observability": { "enabled": true },
  "vars": {
    // The address on the QR code and the invite links: the short link (楽しすぎ！), which sends
    // a 302 to this worker keeping the path and ?code=. Empty: the request's own origin.
    "PUBLIC_URL": "https://tanoshi.s.gy",
    // Optional; e.g. https://voicevox.example.com. Empty: subtitles only.
    "VOICEVOX_URL": "",
    // Optional; the reader service (npm run reader), here on an Oracle Cloud VM. Empty: kanji answers
    // are compared as written. READER_TOKEN is a secret (wrangler secret put READER_TOKEN).
    "READER_URL": "https://141-148-186-1.sslip.io",
    // Speech to text: "workers-ai" runs Whisper on Cloudflare Workers AI through the AI binding above, or a
    // self-hosted Whisper server's endpoint, e.g. https://stt.example.com/inference.
    // Empty: no hold-to-talk, phones type or tap. Audio never goes to Google (docs/speech.md).
    "STT_URL": "workers-ai",
    // Optional; the Workers AI model (default @cf/openai/whisper-large-v3-turbo), or the `model` field for
    // self-hosted servers that host several (speaches). whisper.cpp ignores it.
    "STT_MODEL": "",
    // The Claude model for the host's lines and the Onsen suspects' lead-ins. A suspect's lead-in has to
    // arrive within its 1.8 s thinking beat: claude-opus-5-5 (the default) took 1.7 to 5.4 s and missed it,
    // claude-haiku-5-5 took about 0.9 s. The answer judge keeps the default (KOTOBA_JUDGE_MODEL).
    "KOTOBA_HOST_MODEL": "claude-haiku-5-5"
  }
}
