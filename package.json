{
  "name": "kotoba-party",
  "version": "0.0.1",
  "private": true,
  "description": "A Jackbox-style party game for learning to speak Japanese.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsx tools/build.ts",
    "start": "npm run build && tsx server/src/main.ts",
    "dev": "npm run build && tsx watch server/src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gate": "vitest run tests/gate.test.ts tests/reconnect.test.ts",
    "bots": "tsx tools/bots/cli.ts",
    "content:readings": "tsx tools/content-readings.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "kuromoji": "^0.1.2",
    "qrcode": "^1.5.4",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
